# .env にコピーして書き換える
# OpenAI 互換の音声 API（audio.cpp の audiocpp_server や llama-swap など）
VOICE_API_BASE=http://localhost:8080/v1
# 文字起こしを別のサーバでやるなら（省略すると VOICE_API_BASE）
# ASR_API_BASE=http://localhost:8081/v1
TTS_MODEL=qwen3-tts-base
ASR_MODEL=whisper-large-v3-turbo
# 参照音声のアップロード先（audio.cpp の /v1/ui/upload）。llama-swap 越しなら次のように
# UPLOAD_URL=https://example.com/upstream/qwen3-tts-base/v1/ui/upload
# 比較用の別人の声（空にすると作らない）
PRESET_MODEL=qwen3-tts
PRESET_VOICE=Ono_Anna
